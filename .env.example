# Copy to .env and fill in. Only needed for the real-API scripts; the mocked
# pytest suite runs without any of these.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to 1 to force all adapters (STT/LLM/TTS) into deterministic mock mode.
USE_MOCKS=0

# Model IDs (defaults shown).
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Database (PoC: local SQLite).
DATABASE_URL=sqlite:///./aeiou.db

# v3: POST /situations/custom (사용자 맞춤 상황 생성) 게이트.
# 1 또는 헤더 X-Premium: true가 있으면 허용, 아니면 402.
ENABLE_PREMIUM=0
